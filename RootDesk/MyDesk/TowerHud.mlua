@Logic
script TowerHud extends Logic

	property Entity floorText = "5e1d9b4c-7048-4b56-ae66-2485c7b9fe1e"

	property Entity gameOverPanel = "02f1a3e8-16f5-41e7-89c6-47d80bb613ce"

	property Entity reachedText = "714de251-b3d8-427b-80a2-b54a0ccf6e1f"

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		local player = _UserService.LocalPlayer
		---@type TowerClimber
		local climber = player:GetComponent("script.TowerClimber")
		self.floorText.TextComponent.Text = "탑 " .. (climber.floor + 1) .. "층"
	end

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		self.gameOverPanel.Enable = false
	end

	@ExecSpace("ClientOnly")
	method void ShowGameOver(integer reachedFloor)
		self.reachedText.TextComponent.Text = "탑 " .. reachedFloor .. "층까지 올랐습니다"
		self.gameOverPanel.Enable = true
		_TimerService:SetTimerOnce(function()
			self.gameOverPanel.Enable = false
		end, 2.5)
	end

end