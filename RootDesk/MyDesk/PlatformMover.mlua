@Component
script PlatformMover extends Component

	property number swing = 0.6

	property Vector3 center = Vector3(0,0,0)

	property number elapsed = 0

	property boolean isMoving = false

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		self.center = self.Entity.TransformComponent.Position
	end

	@ExecSpace("ServerOnly")
	method void OnUpdate(number delta)
		self.elapsed += delta
		local offset = math.sin(self.elapsed * 2 * math.pi / 3) * self.swing
		self.Entity.TransformComponent.Position = self.center + Vector3(offset, 0, 0)
	end

	@ExecSpace("ServerOnly")
	method void StartMoving(Vector3 newCenter)
		
	end

	@ExecSpace("ServerOnly")
	method void StopMoving()
		
	end

end