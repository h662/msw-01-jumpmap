@Component
script TowerRecord extends Component

	@Sync
	property integer bestFloor = 0

	@ExecSpace("ServerOnly")
	method void Reached(integer reachedFloor)
		if reachedFloor <= self.bestFloor then
			return
		end
		self.bestFloor = reachedFloor
		log("최고 기록 " .. self.bestFloor)
		local storage = _DataStorageService:GetUserDataStorage(self.Entity.PlayerComponent.ProfileCode)
		storage:SetAsync("TowerBest", tostring(self.bestFloor), function(errorCode, key)
			log("저장 " .. errorCode)
		end)
	end

end