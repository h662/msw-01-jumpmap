@Component
script TowerClimber extends Component

	@Sync
	property integer floor = 0

	property boolean isTeleporting = false

	property Vector3 teleportTarget = Vector3(0, 0, 0)

	property number teleportSeconds = 0

	@ExecSpace("ServerOnly")
	method void ClimbTo(integer nextFloor)
		if self.isTeleporting or nextFloor <= self.floor then
			return
		end
		self.floor = nextFloor
		log("floor " .. self.floor)
		self:TeleportTo(Vector3(0, nextFloor * 4 + 0.5, 0))
	end

	@ExecSpace("ClientOnly")
	method void OnSyncProperty(string name, any value)
		if name == "floor" then
			log("floor " .. value)
		end
	end

	@ExecSpace("ServerOnly")
	method void OnUpdate(number delta)
		if self.isTeleporting then
			self.teleportSeconds += delta
			local distance = self.Entity.TransformComponent.WorldPosition:Distance(self.teleportTarget)
			if distance < 1 or self.teleportSeconds > 1 then
				self.isTeleporting = false
			end
			return
		end
		local y = self.Entity.TransformComponent.WorldPosition.y
		if y < self.floor * 4 - 1 then
			self:GameOver()
		end
	end

	@ExecSpace("ServerOnly")
	method void GameOver()
		self.floor = 0
		log("게임오버")
		self:TeleportTo(Vector3(0, 0.5, 0))
	end

	@ExecSpace("ServerOnly")
	method void TeleportTo(Vector3 target)
		self.isTeleporting = true
		self.teleportTarget = target
		self.teleportSeconds = 0
		_TeleportService:TeleportToMapPosition(self.Entity, target, "map01")
	end

	@ExecSpace("Client")
	method void ShowGameOver(integer reachedFloor)
		_TowerHud:ShowGameOver(reachedFloor)
	end

end