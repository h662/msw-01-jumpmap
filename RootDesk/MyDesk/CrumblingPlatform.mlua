@Component
script CrumblingPlatform extends Component

	property string state = "Waiting"

	property number timer = 0

	property number shakeSeconds = 0.8

	property number goneSeconds = 3

	property Vector3 home = Vector3(0,0,0)

	@ExecSpace("ServerOnly")
	method void OnUpdate(number delta)
		if self.state == "Waiting" then
			local before = self.timer
			self.timer += delta
			if before < 1 and self.timer >= 1 then
				self.Entity.TransformComponent.Position = self.home + Vector3(0.01, 0, 0)
				self.Entity.TransformComponent.Position = self.home
			end
			for i, user in ipairs(_UserService.UserEntities.Values) do
				local body = user.RigidbodyComponent
				local foothold = body:GetCurrentFoothold()
				if body:IsOnGround() and foothold ~= nil and foothold.OwnerId == self.Entity.Id then
					self:ChangeState("Shaking")
				end
			end
		elseif self.state == "Shaking" then
			self.timer += delta
			local shake = math.sin(self.timer * 60) * 0.03
			self.Entity.TransformComponent.Position = self.home + Vector3(shake, 0, 0)
			if self.timer >= self.shakeSeconds then
				self:ChangeState("Gone")
			end
		elseif self.state == "Gone" then
			self.timer += delta
			if self.timer >= self.goneSeconds then
				self:ChangeState("Waiting")
			end
		end
	end

	@ExecSpace("ServerOnly")
	method void ChangeState(string nextState)
		self.state = nextState
		self.timer = 0
		if nextState == "Waiting" then
			self.Entity.TransformComponent.Position = self.home
			self.Entity.SpriteRendererComponent.Color = Color(1, 1, 1, 1)
			self.Entity.SpriteRendererComponent.Enable = true
			self.Entity.CustomFootholdComponent.Enable = true
		elseif nextState == "Shaking" then
			self.Entity.SpriteRendererComponent.Color = Color(1, 0.55, 0.55, 1)
		elseif nextState == "Gone" or nextState == "Off" then
			self.Entity.SpriteRendererComponent.Enable = false
			self.Entity.CustomFootholdComponent.Enable = false
		end
	end

	@ExecSpace("ServerOnly")
	method void PlaceAt(Vector3 here)
		self.home = here
		self:ChangeState("Waiting")
	end

	@ExecSpace("ServerOnly")
	method void Retire()
		self:ChangeState("Off")
	end

end