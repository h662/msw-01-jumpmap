@Component
script FloorExit extends Component

	property integer nextFloor = 0

	@ExecSpace("ServerOnly")
	@EventSender("Self")
	handler HandleTriggerEnterEvent(TriggerEnterEvent event)
		local player = event.TriggerBodyEntity
		---@type TowerClimber
		local climber = player:GetComponent("script.TowerClimber")
		if climber == nil then
			return
		end
		climber:ClimbTo(self.nextFloor)
	end

end
