@Component
script TrapBlinker extends Component

	property number blinkSeconds = 1.5

	property number elapsed = 0

	property boolean isLit = true

	@ExecSpace("ServerOnly")
	method void OnUpdate(number delta)
		self.elapsed += delta
		if self.elapsed >= self.blinkSeconds then
			self.elapsed = 0
			self.isLit = not self.isLit
			if self.isLit then
				self.Entity.SpriteRendererComponent.Color = Color(1, 1, 1, 1)
			else
				self.Entity.SpriteRendererComponent.Color = Color(1, 1, 1, 0.25)
			end
		end
	end

end