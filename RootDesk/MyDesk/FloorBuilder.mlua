@Component
script FloorBuilder extends Component

    method void OnBeginPlay()
        local layout = {
            { x = 0,    y = 0 },
            { x = 2.9,  y = 0.5 },
            { x = 5.8,  y = 1.0 },
            { x = 8.7,  y = 1.5 },
            { x = 11.6, y = 2.0 },
            { x = 14.5, y = 2.5 },
            { x = 17.4, y = 3.0 },
        }
        for i, spot in ipairs(layout) do
            log(i, spot.x, spot.y)
        end
    end

end
