@Component
script FloorBuilder extends Component

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		        local maxGap = { [-1] = 0.8, [0] = 0.6, [1] = 0.5 }
		        local layout = { { x = 0, y = 0 } }
		        for i, spot in ipairs(layout) do
		            local platform = self.Entity:GetChildByName("Platform" .. i)
		            platform.TransformComponent.Position = Vector3(spot.x, spot.y, 0)
		        end
	end

end