@Component
script FloorBuilder extends Component

	property integer hardestFloor = 10

	property number gapSqueeze = 0.7

	property table stock = {}

	property table built = {}

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		        local away = Vector3(-30, 0, 0)
		        self.stock = { Long = {}, Short = {}, Exit = {}, Mover = {}, Crumble = {}, Spike = {}, Fire = {}, Sign = {} }
		        for i = 1, 42 do
		            local long = self.Entity:GetChildByName("Platform" .. i)
		            local short = self.Entity:GetChildByName("Short" .. i)
		            long.TransformComponent.Position = away
		            short.TransformComponent.Position = away
		            table.insert(self.stock.Long, long)
		            table.insert(self.stock.Short, short)
		        end
		        for i = 1, 12 do
		            local exit = self.Entity:GetChildByName("Exit" .. i)
		            exit.TransformComponent.Position = away
		            table.insert(self.stock.Exit, exit)
		        end
		        for i = 1, 12 do
		            local mover = self.Entity:GetChildByName("Mover" .. i)
		            mover.TransformComponent.Position = away
		            table.insert(self.stock.Mover, mover)
		        end
		        for i = 1, 12 do
		            local crumble = self.Entity:GetChildByName("Crumble" .. i)
		            ---@type CrumblingPlatform
		            local crumbling = crumble:GetComponent("script.CrumblingPlatform")
		            crumbling:Retire()
		            crumble.TransformComponent.Position = away
		            table.insert(self.stock.Crumble, crumble)
		        end
		        for i = 1, 12 do
		            local spike = self.Entity:GetChildByName("Spike" .. i)
		            spike.TransformComponent.Position = away
		            table.insert(self.stock.Spike, spike)
		        end
		        for i = 1, 12 do
		            local fire = self.Entity:GetChildByName("Fire" .. i)
		            fire.TransformComponent.Position = away
		            table.insert(self.stock.Fire, fire)
		        end
		        for i = 1, 12 do
		            local sign = self.Entity:GetChildByName("Sign" .. i)
		            sign.TransformComponent.Position = away
		            table.insert(self.stock.Sign, sign)
		        end
		        self:RefreshFloors()
	end

	@ExecSpace("ServerOnly")
	method void BuildFloor(integer floor)
		        local pieces = {}
		        local hardness = math.min(1, floor / self.hardestFloor)
		        log("floor " .. floor .. " 어려움 " .. hardness)
		        local maxGap = { [-1] = 0.8, [0] = 0.6, [1] = 0.5 }
		        local half = { Long = 1.2, Short = 0.5, Mover = 0.5 + 0.6, Crumble = 0.42 }
		        local shortChance = 0.5 + hardness * 0.3
		        local layout = { { kind = "Long", x = 0, y = 0 } }
		        local moverAt = 0
		        if floor >= 2 then
		            moverAt = _UtilLogic:RandomIntegerRange(2, 6)
		        end
		        local crumbleAt = 0
		        if floor >= 5 then
		            local spots = {}
		            for i = 2, 6 do
		                if i ~= moverAt then
		                    table.insert(spots, i)
		                end
		            end
		            crumbleAt = spots[_UtilLogic:RandomIntegerRange(1, #spots)]
		        end
		        for i = 2, 7 do
		            local before = layout[i - 1]
		            local kind = "Long"
		            if _UtilLogic:RandomDouble() < shortChance then
		                kind = "Short"
		            end
		            if i == moverAt then
		                kind = "Mover"
		            end
		            if i == crumbleAt then
		                kind = "Crumble"
		            end
		            local step = _UtilLogic:RandomIntegerRange(-1, 1)
		            if before.y + step * 0.5 < 0 then
		                step = 1
		            elseif before.y + step * 0.5 > 1.5 then
		                step = -1
		            end
		            local smallestGap = 0.3 + hardness * self.gapSqueeze * (maxGap[step] - 0.3)
		            local gap = smallestGap + _UtilLogic:RandomDouble() * (maxGap[step] - smallestGap)
		            layout[i] = { kind = kind, x = before.x + half[before.kind] + gap + half[kind], y = before.y + step * 0.5 }
		        end
		        local spikeAt = 0
		        if floor >= 3 then
		            local longs = {}
		            for i = 2, 6 do
		                if layout[i].kind == "Long" then
		                    table.insert(longs, i)
		                end
		            end
		            if #longs > 0 then
		                spikeAt = longs[_UtilLogic:RandomIntegerRange(1, #longs)]
		            end
		        end
		        local fireAt = 0
		        if floor >= 4 then
		            local shorts = {}
		            for i = 2, 6 do
		                if layout[i].kind == "Short" then
		                    table.insert(shorts, i)
		                end
		            end
		            if #shorts > 0 then
		                fireAt = shorts[_UtilLogic:RandomIntegerRange(1, #shorts)]
		            end
		        end
		        local isComplete = true
		        for i, spot in ipairs(layout) do
		            local platform = table.remove(self.stock[spot.kind], 1)
		            if platform == nil then
		                isComplete = false
		                break
		            end
		            local here = Vector3(spot.x, floor * 4 + spot.y, 0)
		            if spot.kind == "Mover" then
		                ---@type PlatformMover
		                local mover = platform:GetComponent("script.PlatformMover")
		                mover:StartMoving(here)
		            elseif spot.kind == "Crumble" then
		                ---@type CrumblingPlatform
		                local crumbling = platform:GetComponent("script.CrumblingPlatform")
		                crumbling:PlaceAt(here - Vector3(0, 0.17, 0))
		            else
		                platform.TransformComponent.Position = here
		            end
		            table.insert(pieces, { kind = spot.kind, entity = platform })
		            if i == spikeAt and #self.stock.Spike > 0 then
		                local spike = table.remove(self.stock.Spike, 1)
		                spike.TransformComponent.Position = here + Vector3(0, 0.26, 0)
		                table.insert(pieces, { kind = "Spike", entity = spike })
		            end
		            if i == fireAt and #self.stock.Fire > 0 then
		                local fire = table.remove(self.stock.Fire, 1)
		                fire.TransformComponent.Position = here + Vector3(0, 0.33, 0)
		                table.insert(pieces, { kind = "Fire", entity = fire })
		            end
		        end
		        if isComplete and #self.stock.Exit > 0 then
		            local last = layout[7]
		            local exit = table.remove(self.stock.Exit, 1)
		            exit.TransformComponent.Position = Vector3(last.x, floor * 4 + last.y, 0)
		            ---@type FloorExit
		            local floorExit = exit:GetComponent("script.FloorExit")
		            floorExit.nextFloor = floor + 1
		            table.insert(pieces, { kind = "Exit", entity = exit })
		        end
		        if #self.stock.Sign > 0 then
		            local sign = table.remove(self.stock.Sign, 1)
		            sign.TransformComponent.Position = Vector3(0.9, floor * 4 + 0.45, 0)
		            ---@type FloorSign
		            local floorSign = sign:GetComponent("script.FloorSign")
		            floorSign:Show((floor + 1) .. "층")
		            table.insert(pieces, { kind = "Sign", entity = sign })
		        end
		        self.built[floor] = pieces
	end

	@ExecSpace("ServerOnly")
	method void ReleaseFloor(integer floor)
		        for i, piece in ipairs(self.built[floor]) do
		            if piece.kind == "Mover" then
		                ---@type PlatformMover
		                local mover = piece.entity:GetComponent("script.PlatformMover")
		                mover:StopMoving()
		            elseif piece.kind == "Crumble" then
		                ---@type CrumblingPlatform
		                local crumbling = piece.entity:GetComponent("script.CrumblingPlatform")
		                crumbling:Retire()
		            end
		            piece.entity.TransformComponent.Position = Vector3(-30, 0, 0)
		            table.insert(self.stock[piece.kind], piece.entity)
		        end
		        self.built[floor] = nil
	end

	@ExecSpace("ServerOnly")
	method void RefreshFloors()
		        local needed = {}
		        for i, user in ipairs(_UserService.UserEntities.Values) do
		            ---@type TowerClimber
		            local climber = user:GetComponent("script.TowerClimber")
		            needed[climber.floor] = true
		            needed[climber.floor + 1] = true
		        end
		        if next(needed) == nil then
		            needed[0] = true
		            needed[1] = true
		        end
		        for floor in pairs(self.built) do
		            if not needed[floor] then
		                self:ReleaseFloor(floor)
		            end
		        end
		        for floor in pairs(needed) do
		            if self.built[floor] == nil then
		                self:BuildFloor(floor)
		            end
		        end
	end

end