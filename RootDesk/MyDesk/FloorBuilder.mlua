@Component
script FloorBuilder extends Component

	property integer hardestFloor = 10

	property number gapSqueeze = 0.7

	property table stock = {}

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		        local away = Vector3(-30, 0, 0)
		        self.stock = { Long = {}, Short = {}, Exit = {} }
		        for i = 1, 21 do
		            local long = self.Entity:GetChildByName("Platform" .. i)
		            local short = self.Entity:GetChildByName("Short" .. i)
		            long.TransformComponent.Position = away
		            short.TransformComponent.Position = away
		            table.insert(self.stock.Long, long)
		            table.insert(self.stock.Short, short)
		        end
		        for i = 1, 6 do
		            local exit = self.Entity:GetChildByName("Exit" .. i)
		            exit.TransformComponent.Position = away
		            table.insert(self.stock.Exit, exit)
		        end
		        for floor = 0, 2 do
		            self:BuildFloor(floor)
		        end
	end

	@ExecSpace("ServerOnly")
	method void BuildFloor(integer floor)
		        local hardness = math.min(1, floor / self.hardestFloor)
		        log("floor " .. floor .. " 어려움 " .. hardness)
		        local maxGap = { [-1] = 0.8, [0] = 0.6, [1] = 0.5 }
		        local half = { Long = 1.2, Short = 0.5 }
		        local shortChance = 0.5 + hardness * 0.3
		        local layout = { { kind = "Long", x = 0, y = 0 } }
		        for i = 2, 7 do
		            local before = layout[i - 1]
		            local kind = "Long"
		            if _UtilLogic:RandomDouble() < shortChance then
		                kind = "Short"
		            end
		            local step = _UtilLogic:RandomIntegerRange(-1, 1)
		            if before.y + step * 0.5 < 0 then
		                step = 1
		            elseif before.y + step * 0.5 > 1.5 then
		                step = -1
		            end
		            local smallestGap = 0.3 + hardness * self.gapSqueeze * (maxGap[step] - 0.3)
		            local gap = smallestGap + _UtilLogic:RandomDouble() * (maxGap[step] - smallestGap)
		            layout[i] = { kind = kind, x = before.x + half[before.kind] + gap + half[kind], y = before.y + step * 0.5 }
		        end
		        for i, spot in ipairs(layout) do
		            local long = self.Entity:GetChildByName("Platform" .. (floor * 7 + i))
		            local short = self.Entity:GetChildByName("Short" .. (floor * 7 + i))
		            local here = Vector3(spot.x, floor * 4 + spot.y, 0)
		            local away = Vector3(-30, 0, 0)
		            if spot.kind == "Short" then
		                short.TransformComponent.Position = here
		                long.TransformComponent.Position = away
		            else
		                long.TransformComponent.Position = here
		                short.TransformComponent.Position = away
		            end
		        end
		        if floor < 2 then
		            local last = layout[7]
		            local exit = self.Entity:GetChildByName("Exit" .. (floor + 1))
		            exit.TransformComponent.Position = Vector3(last.x, floor * 4 + last.y, 0)
		        end
	end

end